{
    "name": "devlms/moodle-tool_autoflow",
    "description": "Dev tooling for the engine tests outside Moodle (PHPUnit and Infection). Not needed to install the plugin.",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "infection/infection": "^0.29"
    },
    "autoload-dev": {
        "psr-4": {
            "tool_autoflow\\": "classes/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
