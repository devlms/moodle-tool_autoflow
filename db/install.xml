<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="admin/tool/autoflow/db" VERSION="20261031" COMMENT="XMLDB file for tool_autoflow"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="tool_autoflow_workflow" COMMENT="Workflows built in the editor">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="description" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="enabled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="graph" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Graph JSON: nodes and edges"/>
        <FIELD NAME="triggertype" TYPE="char" LENGTH="50" NOTNULL="true" SEQUENCE="false" COMMENT="Type of the trigger node, copied from the graph on save"/>
        <FIELD NAME="triggerdata" TYPE="char" LENGTH="1333" NOTNULL="true" SEQUENCE="false" COMMENT="Event class name or cron expression, copied from the trigger node on save"/>
        <FIELD NAME="lastscheduled" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="When the schedule trigger last queued a run"/>
        <FIELD NAME="runasuserid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="User the workflow runs as. Null means nobody: the workflow does not run."/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="usermodified" TYPE="foreign" FIELDS="usermodified" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="runasuserid" TYPE="foreign" FIELDS="runasuserid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="enabledtrigger" UNIQUE="false" FIELDS="enabled, triggertype"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="tool_autoflow_run" COMMENT="One execution of a workflow">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="workflowid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="queued, running, success, failed"/>
        <FIELD NAME="triggertype" TYPE="char" LENGTH="50" NOTNULL="true" SEQUENCE="false" COMMENT="manual, schedule or event"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="User the trigger was about, if any"/>
        <FIELD NAME="log" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON list of step results"/>
        <FIELD NAME="error" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timefinished" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="workflowid" TYPE="foreign" FIELDS="workflowid" REFTABLE="tool_autoflow_workflow" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="status" UNIQUE="false" FIELDS="status"/>
        <INDEX NAME="workflowtime" UNIQUE="false" FIELDS="workflowid, timecreated"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
