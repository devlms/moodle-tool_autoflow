{{!
    @template tool_autoflow/workflow_list

    List of workflows on the plugin's main page.

    Context variables required for this template:
    * hasworkflows - bool
    * workflows - list of {id, name, enabled, timemodified}

    Example context (json):
    {
        "hasworkflows": true,
        "workflows": [
            {"id": 1, "name": "Welcome new students", "enabled": true, "timemodified": "31 October 2026"}
        ]
    }
}}
<div class="tool_autoflow-list" data-region="workflow-list">
    {{#hasworkflows}}
    <table class="table generaltable">
        <thead>
            <tr>
                <th scope="col">{{#str}}name{{/str}}</th>
                <th scope="col">{{#str}}status{{/str}}</th>
                <th scope="col">{{#str}}lastmodified{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#workflows}}
            <tr data-workflowid="{{id}}">
                <td>{{name}}</td>
                <td>{{#enabled}}{{#str}}enabled, admin{{/str}}{{/enabled}}{{^enabled}}{{#str}}disabled, admin{{/str}}{{/enabled}}</td>
                <td>{{timemodified}}</td>
            </tr>
            {{/workflows}}
        </tbody>
    </table>
    {{/hasworkflows}}
    {{^hasworkflows}}
    <p class="alert alert-info">{{#str}}noworkflows, tool_autoflow{{/str}}</p>
    {{/hasworkflows}}
</div>
