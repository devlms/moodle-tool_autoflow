{
  "name": "tool-autoflow-editor",
  "private": true,
  "description": "React Flow editor for tool_autoflow. Built into frontend/dist/editor.js, which the plugin ships.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
